# SB Launcher API
PORT=8787
HOST=127.0.0.1
DATABASE_URL="file:./dev.db"
APP_URL=http://localhost:8787
DESKTOP_PROTOCOL=sblauncher
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:5173

# Register at https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=
# Optional for a confidential hosted backend. Desktop PKCE does not require it.
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:8787/auth/roblox/callback
ROBLOX_SCOPES="openid profile user.social:read user.inventory-item:read"

# Cloudflare Worker (player registry + update manifest). Empty disables cloud.
SB_CLOUD_URL=https://sb-launcher-cloud.sblauncherrblx.workers.dev
SB_APP_VERSION=2.1.0
SB_BUILD_ID=
