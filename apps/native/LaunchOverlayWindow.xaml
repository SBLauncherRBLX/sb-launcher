<Window x:Class="SBLauncher.Native.LaunchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launching"
        Width="380" Height="230"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
    <Window.Resources>
        <Storyboard x:Key="SnakeStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Snake"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="0" To="-280" Duration="0:0:1.25"/>
        </Storyboard>
    </Window.Resources>
    <Border x:Name="Chrome"
            CornerRadius="18"
            BorderThickness="1.5"
            BorderBrush="#3A4158"
            Background="#1A1D2B"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Border x:Name="MediaLayer" CornerRadius="14" ClipToBounds="True" Margin="-6">
                <Grid>
                    <Border x:Name="ColorLayer" Background="#12141F"/>
                    <Image x:Name="StillImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <MediaElement x:Name="GifMedia"
                                 LoadedBehavior="Manual"
                                 UnloadedBehavior="Manual"
                                 Stretch="UniformToFill"
                                 Visibility="Collapsed"
                                 IsMuted="True"
                                 MediaEnded="GifMedia_MediaEnded"/>
                    <Border Background="#66000000"/>
                </Grid>
            </Border>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="78" Height="78" HorizontalAlignment="Center">
                    <Viewbox Width="78" Height="78" Stretch="Uniform">
                        <Canvas Width="100" Height="100">
                            <Path x:Name="SnakeTrack"
                                  Stroke="#4A4458" StrokeThickness="3.1" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 1.95,49.90 L 2.93,44.04 L 5.18,39.45 L 8.20,35.64 L 11.82,32.32 L 15.72,29.39 L 19.63,26.46 L 23.14,23.14 L 26.46,19.63 L 29.39,15.72 L 32.32,11.82 L 35.64,8.20 L 39.45,5.18 L 44.04,2.93 L 50.00,1.95 L 55.86,2.93 L 60.45,5.18 L 64.26,8.30 L 67.58,11.82 L 70.51,15.72 L 73.44,19.63 L 76.76,23.14 L 80.27,26.46 L 84.18,29.39 L 88.09,32.32 L 91.60,35.64 L 94.73,39.45 L 96.97,44.04 L 97.95,50.00 L 96.97,55.86 L 94.73,60.45 L 91.70,64.26 L 88.09,67.58 L 84.18,70.51 L 80.27,73.44 L 76.66,76.66 L 73.44,80.27 L 70.51,84.18 L 67.58,88.09 L 64.26,91.70 L 60.45,94.73 L 55.86,96.97 L 49.90,97.95 L 44.04,96.97 L 39.45,94.73 L 35.64,91.70 L 32.32,88.09 L 29.39,84.18 L 26.46,80.27 L 23.24,76.66 L 19.63,73.44 L 15.72,70.51 L 11.82,67.58 L 8.20,64.26 L 5.18,60.45 L 2.93,55.86 Z"/>
                            <Path x:Name="Snake"
                                  Stroke="#9A82DB" StrokeThickness="3.4" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  StrokeDashArray="48 232" StrokeDashOffset="0"
                                  Data="M 1.95,49.90 L 2.93,44.04 L 5.18,39.45 L 8.20,35.64 L 11.82,32.32 L 15.72,29.39 L 19.63,26.46 L 23.14,23.14 L 26.46,19.63 L 29.39,15.72 L 32.32,11.82 L 35.64,8.20 L 39.45,5.18 L 44.04,2.93 L 50.00,1.95 L 55.86,2.93 L 60.45,5.18 L 64.26,8.30 L 67.58,11.82 L 70.51,15.72 L 73.44,19.63 L 76.76,23.14 L 80.27,26.46 L 84.18,29.39 L 88.09,32.32 L 91.60,35.64 L 94.73,39.45 L 96.97,44.04 L 97.95,50.00 L 96.97,55.86 L 94.73,60.45 L 91.70,64.26 L 88.09,67.58 L 84.18,70.51 L 80.27,73.44 L 76.66,76.66 L 73.44,80.27 L 70.51,84.18 L 67.58,88.09 L 64.26,91.70 L 60.45,94.73 L 55.86,96.97 L 49.90,97.95 L 44.04,96.97 L 39.45,94.73 L 35.64,91.70 L 32.32,88.09 L 29.39,84.18 L 26.46,80.27 L 23.24,76.66 L 19.63,73.44 L 15.72,70.51 L 11.82,67.58 L 8.20,64.26 L 5.18,60.45 L 2.93,55.86 Z"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
                <TextBlock x:Name="LabelText"
                           Text="Launching Roblox…"
                           Foreground="#E6E1E5"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
