{
  "name": "sb-launcher",
  "version": "2.5.0",
  "private": true,
  "description": "SB Launcher - a customizable Roblox desktop launcher",
  "scripts": {
    "dev": "pnpm --parallel --filter @sb/api --filter @sb/desktop dev",
    "dev:api": "pnpm --filter @sb/api dev",
    "dev:desktop": "pnpm --filter @sb/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @sb/api db:generate",
    "db:migrate": "pnpm --filter @sb/api db:migrate",
    "db:push": "pnpm --filter @sb/api db:push",
    "sync:ui": "powershell -ExecutionPolicy Bypass -File scripts/sync-web-runtime.ps1",
    "deploy:ui": "pnpm --filter @sb/desktop build",
    "deploy:install": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-install.ps1",
    "pack:win": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1"
}

